# =============================================================================
# Staging 覆盖 — 与 docs/onchain-manual/00-addresses.md 对齐的部署地址
# Vite 优先级高于 .env；pnpm env:staging 写入本文件到 .env.local
# Fail-closed：下列键均必填；勿依赖代码 fallback。
# =============================================================================

VITE_API_BASE_URL=https://api.xdpro.cc/api
VITE_API_DERIVE_FROM_DOMAIN=false
VITE_APP_HOST=xdpro.cc

# --- BSC 合约（staging / 手册部署）---
# - USD1 为手册 Faucet / AegisMintableToken（非官方 USD1）
# - USDT 为 staging 测试币（非官方 BSC-USD）；须与 usd1Swap.getConfig() 一致
# - Router / Quoter / WBNB / Multicall3 为 BSC 公共基础设施
# - Referral / PreSale / RewardClaimer / CommunityFund / Usd1Swap / AGX / gAGX / XToken
#   与 docs/onchain-manual/00-addresses.md 一致

