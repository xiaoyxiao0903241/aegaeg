{
  "$schema": "https://react.doctor/schema/config.json",
  // Advisory — not part of `pnpm check`. Prefer isomorphic code fixes; only turn rules
  // off when a “fix” would change product/money/Compiler policy behavior.
  "blocking": "none",
  "ignore": {
    "files": [
      ".scratch/**",
      "dist/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      ".codegraph/**",
      "tmp/**",
      "docs/figma-export/**",
      "scripts/**"
    ]
  },
  "rules": {
    // Foundation compound components (Tile.Label / Dialog slots).
    "react-doctor/only-export-components": "off",
    "react-doctor/no-multi-comp": "off",

    // Policy: keep manual memo until proven redundant (Compiler + vite note).
    "react-doctor/react-compiler-no-manual-memoization": "off",
    // Compiler already stabilizes context values / static allocations — do not add useMemo/hoists for score.
    "react-doctor/jsx-no-constructed-context-values": "off",
    "react-doctor/prefer-module-scope-static-value": "off",
    "react-doctor/prefer-module-scope-pure-function": "off",
    // Money / write paths: sequential awaits are intentional fail-closed ordering.
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/server-sequential-independent-await": "off",
    // Changing keys remounts list rows (observable UI state).
    "react-doctor/no-array-index-as-key": "off",
    // set-state-in-effect / refs / prefer-use-effect-event / advanced-event-handler-refs /
    // no-adjust-state-on-prop-change / no-reset-all-state-on-prop-change — kept on (default).
    "react-doctor/no-pass-data-to-parent": "off",
    // Dead-code SSOT is knip (`pnpm lint:deadcode`), not Doctor deslop.
    "deslop/unused-export": "off",
    "deslop/unused-dependency": "off",
    // Tooling / supply-chain outside app behavior.
    "react-doctor/require-pnpm-hardening": "off",
    // Request layer already maps non-OK; scripts ignored above.
    "react-doctor/no-fetch-response-used-without-status-check": "off",
    // Contract addresses / public Vite env naming — not secrets; FP vs product config.
    "react-doctor/public-env-secret-name": "off",
    "react-doctor/no-secrets-in-client-code": "off",
    // CountValue / motion: permanent will-change is intentional.
    "react-doctor/no-permanent-will-change": "off",
    // A11y / dialog markup — product/Foundation decisions; not silent behavior renames.
    "react-doctor/html-no-nested-interactive": "off",
    "react-doctor/no-polymorphic-children": "off",
    "react-doctor/no-noninteractive-element-to-interactive-role": "off",
    "react-doctor/dialog-has-accessible-name": "off",
    "react-doctor/prefer-html-dialog": "off",
    "react-doctor/no-non-literal-selector-query-without-try-catch": "off",
    // Invalidation owned by existing invalidateAfter* SSOT; do not rewire casually.
    "react-doctor/query-mutation-missing-invalidation": "off"
  },
  "buckets": {
    "compiler-cleanup": "off"
  }
}
