{
  "name": "aegis-dapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "render:home": "node scripts/render-home.mjs",
    "build:tokens": "node scripts/generate-tokens.mjs",
    "env:staging": "node scripts/switch-env.mjs staging",
    "env:prod": "node scripts/switch-env.mjs prod",
    "env:status": "node scripts/switch-env.mjs status",
    "dev": "pnpm build:tokens && pnpm render:home && vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "pnpm build:tokens && tsc -b && pnpm render:home && vite build",
    "probe:bundle": "node scripts/probe-home-bundle.mjs",
    "lint": "eslint .",
    "lint:src": "eslint src --quiet",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "lint:hex": "node scripts/lint-hex.mjs",
    "lint:deadcode": "knip",
    "lint:deadcode:duplicates": "knip --include duplicates",
    "lint:all": "pnpm lint && pnpm lint:css && pnpm lint:hex && pnpm lint:architecture && pnpm lint:deadcode",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{js,cjs,mjs,json,md}\" \"docs/agents/commands.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:classnames": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "test:integration": "node tests/integration/swap-quote-live.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check": "tsc -b && pnpm lint:src && pnpm lint:architecture && pnpm lint:hex && pnpm test:unit",
    "dev:e2e": "pnpm render:home && vite --host 127.0.0.1 --port 5175 --strictPort --force",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=-1"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "core-js": "^3.49.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "regenerator-runtime": "^0.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "thirdweb": "^5.120.0",
    "viem": "^2.54.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.24.0",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@tanstack/react-query": "5.101.0"
    },
    "onlyBuiltDependencies": [
      "bufferutil",
      "core-js",
      "keccak",
      "utf-8-validate"
    ]
  }
}
