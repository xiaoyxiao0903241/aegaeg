{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/main.tsx",
    "src/views/home/main.tsx",
    "src/shared/lib/legacy-core-js.ts",
    "src/views/home/home-renderer.ts",
    "src/i18n/messages/home/index.ts",
    "tests/unit/**/*.test.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/**/*.d.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "terser",
    "regenerator-runtime",
    "core-js",
    "lightningcss"
  ],
  "ignoreIssues": {
    "src/views/dapp/web3/thirdweb.ts": [
      "duplicates",
      "types"
    ],
    "src/shared/styles/tokens/tokens.ts": [
      "types"
    ],
    "src/shared/ui/card.tsx": [
      "types"
    ],
    "src/i18n/messages/app/**": [
      "types"
    ],
    "src/shared/ui/text.tsx": [
      "types"
    ],
    "src/shared/api/account-banned.ts": [
      "exports"
    ],
    "src/stores/auth-store.ts": [
      "exports"
    ],
    "src/views/dapp/auth/login-with-wallet.ts": [
      "exports"
    ],
    "src/views/dapp/auth/session.ts": [
      "exports"
    ],
    "src/core/presale/presale-math.ts": [
      "exports"
    ],
    "src/views/dapp/web3/read-swap-pool.ts": [
      "exports"
    ],
    "src/views/dapp/web3/swap-write.ts": [
      "exports"
    ],
    "src/views/dapp/web3/wallet-contract-write.ts": [
      "exports"
    ],
    "src/shared/config/breakpoints.ts": [
      "exports"
    ]
  }
}
