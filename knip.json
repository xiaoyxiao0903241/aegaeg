{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/main.tsx",
    "src/views/home/main.tsx",
    "src/shared/lib/legacy-core-js.ts",
    "src/views/home/home-renderer.ts",
    "src/i18n/messages/home/index.ts",
    "tests/unit/**/*.test.mjs",
    "tests/unit/knip-traced-exports.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["regenerator-runtime", "lightningcss"],
  "ignoreIssues": {
    "src/web3/thirdweb.ts": ["duplicates", "types"],
    "src/shared/styles/tokens/tokens.ts": ["types"],
    "src/shared/ui/card.tsx": ["types"],
    "src/i18n/messages/app/**": ["types"],
    "src/shared/ui/text.tsx": ["types"]
  }
}
