# =============================================================================
# AEGIS X — 前端打包配置（复制为 `.env` 后修改）
#
# **Fail-closed**：未设置 / 非法值 → 构建与启动直接报错，无代码内地址或密钥兜底。
# 地址目录 SSOT：docs/frontend-manual/00-addresses.md
# 全量地址模板：env/manual.bsc.addresses.env
# CI 公开占位：env/ci.env
#
# Staging / Prod 切换：
#   .env       = prod（本文件复制后填入 thirdweb / RPC / 合约）
#   .env.local = staging 覆盖（gitignore；pnpm env:staging 从 env/staging.local 生成）
#   pnpm env:staging  → 写入 .env.local
#   pnpm env:prod     → 删除 .env.local
#   pnpm env:status   → 查看当前模式
# =============================================================================

# --- 钱包 / RPC（必填）---
VITE_THIRDWEB_CLIENT_ID=
VITE_WALLETCONNECT_PROJECT_ID=
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- API（必填）---
VITE_API_BASE_URL=https://api.x-dao.io/api
VITE_API_DERIVE_FROM_DOMAIN=true
VITE_APP_HOST=aegis-x.io
VITE_AUTH_MESSAGE_FORMAT=siwe
VITE_BSCSCAN_BASE_URL=https://bscscan.com

# --- Exchange 参数（必填）---
VITE_SWAP_DEFAULT_SLIPPAGE_BPS=50
VITE_SWAP_DEADLINE_SECONDS=1200
VITE_PANCAKE_SWAP_BASE_URL=https://pancakeswap.finance/swap

# --- BSC 合约（必填；值须与部署手册一致，勿留空）---
# 下列默认值摘自 docs/frontend-manual/00-addresses.md + 公共 Pancake/WBNB/Multicall3
VITE_BSC_WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
VITE_BSC_USD1=0x32Bb0be09F62bbE69764906d80e9A5782C7F7633
VITE_BSC_USDT=0x55d398326f99059fF775485246999027B3197955

# PancakeSwap V2 Router (BSC public; BondHelper.swapRouter)
VITE_BSC_PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
VITE_BSC_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11
VITE_BSC_REFERRAL=0xe0F3AE113dD3997982AE9ad7d5510ffA4E3Cce71
VITE_BSC_PRESALE=0xDE381f0F124d46Ab7E43629421Ac862b103fe008
VITE_BSC_REWARD_CLAIMER=0x697B55FCFBC4Cd5401f605EE4D9905816c127f07
VITE_BSC_COMMUNITY_FUND_VAULT=0x083441EC373E547611295e037D759084b1483a95
VITE_BSC_USD1_SWAP=0x95EA21C11dd40A7C2b7Ec2f5FBa7b124f3Dec1c0
VITE_BSC_AGX=0x8d0771495272bB97Cd1cD44795222c8fB1b53247
VITE_BSC_GAGX=0xf9D9BC796fC71B119179Bbaf8fcf28fA2393EC51
VITE_BSC_X_TOKEN=0xb6Bc530437e47Be2E5FD47f472C0e291af56BE0A
VITE_BSC_AGX_CONTRIBUTION_SWAP=0xbD664660010de636e3de05B79b16E9963c074541
VITE_BSC_TURBINE=0xd0cA3fD139Fa26Bc76e5Db29b392AD330b7A6dD7

# 其余部署键（质押 / 债券 / 治理等）见 env/manual.bsc.addresses.env；接入对应 rail 时再 require。

# =============================================================================
# 仍为源码写死（非链上部署地址）：
# - src/shared/config/community-links.ts — 社媒链接
# - i18n 文案、Figma 素材、首页 Notion 链接
# - ZERO_ADDRESS（EIP 零地址哨兵，非部署兜底）
# =============================================================================

# PancakePair AGX/USD1 (manual deployment key)
VITE_BSC_PANCAKE_PAIR=0xaC645E2137eB011f612b01942D21De6Be959E266
