# =============================================================================
# AEGIS X — 前端打包配置（复制为 `.env` 后修改）
# Vite 仅在 build/dev 时注入；未设置时使用代码内 fallback（见 src/shared/config/env.ts、contracts.ts）
#
# Staging / Prod 切换：
#   .env       = prod（本文件复制后填入 thirdweb / RPC / prod 合约）
#   .env.local = staging 覆盖（gitignore；pnpm env:staging 从 env/staging.local 生成）
#   pnpm env:staging  → 写入 .env.local（xdpro + 旧合约，覆盖 .env）
#   pnpm env:prod     → 删除 .env.local（仅 .env prod 生效）
#   pnpm env:status   → 查看当前模式
# =============================================================================

# --- 钱包 / RPC ---
# thirdweb Client ID — 未设置时用 env.ts fallback
# VITE_THIRDWEB_CLIENT_ID=a2a60413a78afb90335c14830d5affca

# WalletConnect Project ID — 未设置时用 env.ts fallback
# VITE_WALLETCONNECT_PROJECT_ID=ce2f293d73d2550491678d9ee3c37706

# BSC RPC（链上读写）
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- API ---
# 本地 dev / localhost：始终使用此地址（不根据域名拼接）
VITE_API_BASE_URL=https://api.x-dao.io/api

# 生产环境：true=从访问域名推导 api.{rootDomain}/api；false=强制用 VITE_API_BASE_URL
VITE_API_DERIVE_FROM_DOMAIN=true

# 当 WebView / 注入环境读不到 location 时的兜底域名（仅 hostname，无协议）
VITE_APP_HOST=aegis-x.io

# 登录签名格式：siwe（EIP-4361）| simple
VITE_AUTH_MESSAGE_FORMAT=siwe

# BscScan 链接前缀
VITE_BSCSCAN_BASE_URL=https://bscscan.com

# --- Swap ---
# 默认滑点（bps，50 = 0.5%）
VITE_SWAP_DEFAULT_SLIPPAGE_BPS=50
# 交易 deadline（秒）
VITE_SWAP_DEADLINE_SECONDS=1200
# PancakeSwap 外链根路径（代币地址由下方合约 env 或代码 fallback 拼接）
VITE_PANCAKE_SWAP_BASE_URL=https://pancakeswap.finance/swap

# --- BSC 合约 / 代币（可选；未设置则用 src/config/contracts.ts DEFAULT_BSC_CONTRACTS）---
# VITE_BSC_WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# VITE_BSC_USD1=0x8d0D000Ee44948FC98c9B98A4FA4921476f08B0d
# VITE_BSC_USDT=0x55d398326f99059fF775485246999027B3197955
# VITE_BSC_PANCAKE_V3_SWAP_ROUTER=0x1b81D678ffb9C0263b24A97847620C99d213eB14
# VITE_BSC_PANCAKE_V3_QUOTER=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
# VITE_BSC_USDT_USD1_POOL=0x9c4ee895e4f6ce07ada631c508d1306db7502cce
# VITE_BSC_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11
# VITE_BSC_REFERRAL=0xFe7803230D11BC6FB248f1629a3353E409a2DB29
# VITE_BSC_PRESALE=0xcb8EBEbd2B4A03AB16A28021AD9Ed50B125bE618
# VITE_BSC_REWARD_CLAIMER=0xC6B3D73bA06594dc78be538F65307c6eb348E13E
