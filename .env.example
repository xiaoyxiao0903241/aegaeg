# =============================================================================
# AEGIS X — 前端打包配置（复制为 `.env` 后修改）
#
# **Fail-closed**：未设置 / 非法值 → 构建与启动直接报错，无代码内地址或密钥兜底。
# 地址目录 SSOT：docs/frontend-manual/00-addresses.md
# 全量地址模板：env/manual.bsc.addresses.env
# CI 公开占位：env/ci.env
#
# Staging / Prod 切换：
#   .env       = prod（本文件复制后填入 thirdweb / RPC / 合约）
#   .env.local = staging 覆盖（gitignore；pnpm env:staging 从 env/staging.local 生成）
#   pnpm env:staging  → 写入 .env.local
#   pnpm env:prod     → 删除 .env.local
#   pnpm env:status   → 查看当前模式
# =============================================================================

# --- 钱包 / RPC（必填）---
# thirdweb 客户端 ID（控制台申请；勿提交生产密钥到公开仓）
VITE_THIRDWEB_CLIENT_ID=
# WalletConnect Cloud Project ID
VITE_WALLETCONNECT_PROJECT_ID=
# BSC 主 RPC（读链 / 写链公共入口）
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org
# 可选：逗号分隔备用 RPC（主节点失败时 fallback；未设也会用公共种子）
# VITE_BSC_RPC_FALLBACK_URLS=https://bsc-dataseed1.binance.org,https://rpc.ankr.com/bsc

# --- API（必填）---
# 后端 API 根路径（含 /api）
VITE_API_BASE_URL=https://api.x-dao.io/api
# 是否按当前域名派生 API（true/false）
VITE_API_DERIVE_FROM_DOMAIN=true
# 应用规范主机名（不含协议；location 不可读时兜底）
VITE_APP_HOST=aegis-x.io
# SIWE / 登录消息格式标识
VITE_AUTH_MESSAGE_FORMAT=siwe
# BscScan 浏览器根 URL（交易 / 地址外链）
VITE_BSCSCAN_BASE_URL=https://bscscan.com

# --- Exchange 参数（必填）---
# 默认滑点（基点；50 = 0.5%）
VITE_SWAP_DEFAULT_SLIPPAGE_BPS=50
# 交易截止时间（秒）
VITE_SWAP_DEADLINE_SECONDS=1200
# PancakeSwap 外链兑换页根 URL
VITE_PANCAKE_SWAP_BASE_URL=https://pancakeswap.finance/swap

# --- 社区社媒（必填；运营可改，无代码兜底）---
VITE_COMMUNITY_YOUTUBE_URL=https://www.youtube.com/@AegisxDAO
VITE_COMMUNITY_MEDIUM_URL=https://medium.com/@AegisX__
VITE_COMMUNITY_TWITTER_URL=https://x.com/AegisX__
VITE_COMMUNITY_TELEGRAM_URL=https://t.me/xdao_officialchannel

# --- Notion 文档外链（必填；中/英分表）---
VITE_NOTION_ZH_WHITEPAPER_URL=https://xdaoaegis.notion.site/37fdd8755b98809183dcdfb90e2c82ce
VITE_NOTION_ZH_DOCS_URL=https://xdaoaegis.notion.site
VITE_NOTION_ZH_ECONOMIC_MODEL_URL=https://xdaoaegis.notion.site/37fdd8755b9880df8e5bc705e3438665
VITE_NOTION_EN_WHITEPAPER_URL=https://xdaoaegis.notion.site/Read-Whitepaper-V1-0-37fdd8755b988085a906cd5cb6ad5ee0
VITE_NOTION_EN_DOCS_URL=https://xdaoaegis.notion.site/en
VITE_NOTION_EN_ECONOMIC_MODEL_URL=https://xdaoaegis.notion.site/Read-Economic-Model-Analysis-37fdd8755b98807282ede05961292be2

# --- BSC 合约（必填；值须与部署手册一致，勿留空）---
