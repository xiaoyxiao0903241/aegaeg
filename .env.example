# =============================================================================
# AEGIS X — 前端打包配置（复制为 `.env` 后修改）
#
# **Fail-closed**：未设置 / 非法值 → 构建与启动直接报错，无代码内地址或密钥兜底。
# 地址目录 SSOT：docs/frontend-manual/00-addresses.md
# 全量地址模板：env/manual.bsc.addresses.env
# CI 公开占位：env/ci.env
#
# Staging / Prod 切换：
#   .env       = prod（本文件复制后填入 thirdweb / RPC / 合约）
#   .env.local = staging 覆盖（gitignore；pnpm env:staging 从 env/staging.local 生成）
#   pnpm env:staging  → 写入 .env.local
#   pnpm env:prod     → 删除 .env.local
#   pnpm env:status   → 查看当前模式
# =============================================================================

# --- 钱包 / RPC（必填）---
VITE_THIRDWEB_CLIENT_ID=
VITE_WALLETCONNECT_PROJECT_ID=
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org
# 可选：逗号分隔备用 RPC（主节点失败时 fallback；未设也会用公共种子）
# VITE_BSC_RPC_FALLBACK_URLS=https://bsc-dataseed1.binance.org,https://rpc.ankr.com/bsc

# --- API（必填）---
VITE_API_BASE_URL=https://api.x-dao.io/api
VITE_API_DERIVE_FROM_DOMAIN=true
VITE_APP_HOST=aegis-x.io
VITE_AUTH_MESSAGE_FORMAT=siwe
VITE_BSCSCAN_BASE_URL=https://bscscan.com

# --- Exchange 参数（必填）---
VITE_SWAP_DEFAULT_SLIPPAGE_BPS=50
VITE_SWAP_DEADLINE_SECONDS=1200
VITE_PANCAKE_SWAP_BASE_URL=https://pancakeswap.finance/swap

# --- BSC 合约（必填；值须与部署手册一致，勿留空）---
